{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Run lessonone.js",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder}/Javascript/lessonone.js"
      },
      {
        "type": "chrome",
        "request": "launch",
        "name": "Launch Chrome",
        "url": "http://localhost:8080",
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true,
        "runtimeArgs": [
          "--remote-debugging-port=9222" // Explicitly set Chrome's debug port
        ]
      }
    ]
  }